# profile A —— 平台侧 Moondream2（现有方案，不变）
#
# 形态：NX 只取图，compressed_image 经 HTTP 回传到平台，模型在平台上跑。
#   NX   : ros1_odin_node --serve --port 8730     （系统 python，有 ROS，零安装）
#   平台 : cli --source http --backend moondream  （平台的 GPU 环境）
#
# 适用：客户接受数据回传；或清单里 yes_no / state 占多数需要精度基准。
# 代价：依赖网络。实测 compressed 4.60 MB/s，raw 69.80 MB/s——raw 回传不现实，
#       所以这条路必须走 compressed（默认已经是）。

PROFILE_ID="A"
PROFILE_NAME="平台侧 Moondream2"
BACKEND="moondream"
MODEL_DIR="models/moondream2"

# 空表示用当前环境。平台侧的 torch 环境是现成的，不需要为它单独建 venv。
VENV=""

# 模型跑在平台上，所以推理端默认从 NX 的取图服务拉图。
SOURCE="http"
HTTP_URL="http://<PERCEPTION_HOST>:8730"

TASKS="configs/tasks/demo.yaml"

# 平台有独显，长边给足，细节保留得多一些。
INFER_LONG_SIDE="768"
