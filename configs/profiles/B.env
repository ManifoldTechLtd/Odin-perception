# profile B —— 端侧 SmolVLM-500M（推荐的端侧方案）
#
# 形态：全部跑在 Go2 NX 上，图不出机器。
#   进程1 : ros1_odin_node --serve --port 8730   （系统 python，有 ROS）
#   进程2 : cli --source http --backend smolvlm  （venv，有 torch，不需要 ROS）
#
# 为什么端侧也要拆两个进程：ROS 1 Noetic 的 rospy 装在系统 python3.8 里，
# 而 torch 必须装进独立 venv（不能污染导航程序的依赖）。让 venv 去继承 rospy
# 很容易把两边的 numpy 版本搞冲突，所以用 HTTP 把两个环境隔开——
# 这也是 `capture/frame_server.py` 存在的原因，不是为了跨机器，是为了跨环境。
#
# 为什么选 SmolVLM 而不是 Florence-2：SmolVLM 是真正的自由问答模型，
# 业务层、prompt、判定逻辑跟 profile A 完全一致，换过来没有任何能力损失，
# 只是体积从 3.7GB 降到 1.0GB。Florence-2 更小但不能自由问答，见 B2。

PROFILE_ID="B"
PROFILE_NAME="端侧 SmolVLM-500M"
BACKEND="smolvlm"
MODEL_DIR="models/smolvlm-500m"

# 端侧必须隔离：NX 上有导航程序在跑，绝不能动系统 site-packages。
VENV=".venv-edge"

# 同一台机器上的两个进程，走本地回环，不占网口带宽。
SOURCE="http"
HTTP_URL="http://127.0.0.1:8730"

TASKS="configs/tasks/demo.yaml"

# NX 要跟导航程序抢算力，长边压到 512 换延迟。
# 512 是保守值，实测后可以往上调——ROI 裁剪之后目标本来就占满画面了。
INFER_LONG_SIDE="512"
